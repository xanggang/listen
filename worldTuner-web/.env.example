# Local development defaults to http://127.0.0.1:8787; set this only to override it.
# In Cloudflare production, omit this variable to use LISTEN_API Service Binding.
# LISTEN_API_BASE_URL=http://127.0.0.1:8787

# Optional: override the existing public MapTiler browser key used by the globe.
NEXT_PUBLIC_MAPTILER_KEY=
