{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "listen-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-12-01",
  "observability": { "enabled": true },
  "vars": { "ALLOWED_ORIGINS": "http://localhost:3000,http://127.0.0.1:3000" },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "listen",
    "database_id": "8b3bfe83-4091-4dbb-b199-6d42b3babf71",
    "migrations_dir": "migrations"
  }],
  "ratelimits": [
    { "name": "READ_LIMITER", "namespace_id": "2026092401", "simple": { "limit": 180, "period": 60 } },
    { "name": "SEARCH_LIMITER", "namespace_id": "2026092402", "simple": { "limit": 30, "period": 60 } }
  ]
}
