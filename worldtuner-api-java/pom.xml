<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.worldtuner</groupId>
  <artifactId>worldtuner-api-java</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>worldtuner-api-java</name>
  <description>WorldTuner 下一代 API：Java 21 + Spring Boot 3 + SQLite，多端分包预留</description>

  <modules>
    <module>worldtuner-common</module>
    <module>worldtuner-domain</module>
    <module>worldtuner-client-api</module>
    <module>worldtuner-admin-api</module>
    <module>worldtuner-bootstrap</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <spring-boot.version>3.5.6</spring-boot.version>
    <mybatis.version>3.5.19</mybatis.version>
    <mybatis-spring.version>3.0.5</mybatis-spring.version>
    <sqlite-jdbc.version>3.50.3.0</sqlite-jdbc.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.mybatis</groupId>
        <artifactId>mybatis</artifactId>
        <version>${mybatis.version}</version>
      </dependency>
      <dependency>
        <groupId>org.mybatis</groupId>
        <artifactId>mybatis-spring</artifactId>
        <version>${mybatis-spring.version}</version>
      </dependency>
      <dependency>
        <groupId>org.xerial</groupId>
        <artifactId>sqlite-jdbc</artifactId>
        <version>${sqlite-jdbc.version}</version>
      </dependency>
      <!-- 内部模块版本统一由父工程管理 -->
      <dependency>
        <groupId>com.worldtuner</groupId>
        <artifactId>worldtuner-common</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.worldtuner</groupId>
        <artifactId>worldtuner-domain</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.worldtuner</groupId>
        <artifactId>worldtuner-client-api</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.worldtuner</groupId>
        <artifactId>worldtuner-admin-api</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.2</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
