<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.worldtuner</groupId>
    <artifactId>worldtuner-api-java</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>worldtuner-bootstrap</artifactId>
  <name>worldtuner-bootstrap</name>
  <description>Spring Boot 启动器：装配数据源、过滤器、统一错误处理与定时任务，打包为单个可执行 jar</description>

  <dependencies>
    <dependency>
      <groupId>com.worldtuner</groupId>
      <artifactId>worldtuner-client-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.worldtuner</groupId>
      <artifactId>worldtuner-admin-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.mybatis</groupId>
      <artifactId>mybatis</artifactId>
    </dependency>
    <dependency>
      <groupId>org.mybatis</groupId>
      <artifactId>mybatis-spring</artifactId>
    </dependency>
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <!-- 3.5.0 已在本地仓库可用；repackage 与 3.5.x 依赖兼容 -->
        <version>3.5.0</version>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
