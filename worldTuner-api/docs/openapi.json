    "/metrics/visit": {
      "post": {
        "operationId": "recordAnonymousVisit",
        "tags": [
          "metrics"
        ],
        "description": "Records one page view. The server derives UTC day/month hashes and stores no raw visitor ID. No account or authentication is involved; the result is approximate usage analytics.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "visitorId",
                  "source",
                  "page"
                ],
                "properties": {
                  "visitorId": {
                    "type": "string",
                    "format": "uuid",
                    "description": "Random anonymous UUID stored only on the client."
                  },
                  "source": {
                    "type": "string",
                    "enum": [
                      "web",
                      "android"
                    ]
                  },
                  "page": {
                    "type": "string",
                    "enum": [
                      "welcome",
                      "map",
                      "discover",
                      "search",
                      "charts",
                      "settings",
                      "vip",
                      "player"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Visit accepted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "recorded": {
                          "type": "boolean"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid or unexpected field"
          },
          "413": {
            "description": "Request body exceeds 1024 characters"
          },
          "415": {
            "description": "JSON content type required"
          },
          "429": {
            "description": "Metrics write rate limit exceeded"
          }
        }
      }
    },
    "/map/snapshot": {
      "get": {
        "operationId": "mapSnapshot",
        "description": "全部公开且有有效坐标的电台，不分页、不聚合。四字段元组，坐标保留五位小数。默认 TTL 300 秒，支持 gzip、弱 ETag；不接受查询参数。",
        "parameters": [
          {
            "in": "header",
            "name": "If-None-Match",
            "schema": {
              "type": "string"
            },
            "description": "上次 ETag；支持多标签与 *。"
          },
          {
            "in": "header",
            "name": "Accept-Encoding",
            "schema": {
              "type": "string"
            },
            "description": "接受 gzip 时压缩，gzip;q=0 返回 identity。"
          }
        ],
        "responses": {
          "200": {
            "description": "全量点位；ETag 校验和剩余缓存 TTL。",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string"
                }
              },
              "Vary": {
                "schema": {
                  "type": "string"
                }
              },
              "Content-Encoding": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "gzip"
                  ]
                },
                "description": "仅 gzip 正文包含此头。"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "object",
                      "required": [
                        "count",
                        "points"
                      ],
                      "properties": {
                        "count": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "points": {
                          "type": "array",
                          "items": {
                            "type": "array",
                            "minItems": 4,
                            "maxItems": 4,
                            "description": "固定顺序：[19 位字符串 ID, name, longitude, latitude]；OAS 3.0 不支持位置类型校验。",
                            "items": {
                              "oneOf": [
                                {
                                  "type": "string"
                                },
                                {
                                  "type": "number"
                                }
                              ]
                            },
                            "example": [
                              "0363513228099059713",
                              "Radio",
                              -87.90647,
                              43.0389
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "304": {
            "description": "内容未改变，无正文；复用现有快照并更新缓存有效期。",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "不接受查询参数。"
          },
          "429": {
            "description": "读取限流。"
          },
          "503": {
            "description": "数据源暂时不可用，不缓存失败响应。"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EntityId": {
        "type": "string",
        "pattern": "^[0-9]{19}$",
        "example": "0363513228099059713",
        "description": "19 位十进制字符串，保留前导零，禁止转换为 Number。"
      },
      "Station": {
        "type": "object",
        "required": [
          "id",
          "name",
          "url",
          "urlResolved",
          "geoLat",
          "geoLong",
          "catalogStatus"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/EntityId"
          },
          "name": {
            "type": "string"
          },
          "countryId": {
            "type": "string",
            "pattern": "^[0-9]{19}$",
            "example": "0363513228099059713",
            "description": "19 位十进制字符串，保留前导零，禁止转换为 Number。",
            "nullable": true
          },
          "website": {
            "type": "string",
            "nullable": true
          },
          "favicon": {
            "type": "string",
            "nullable": true
          },
          "place": {
            "type": "string",
            "nullable": true
          },
          "country": {
            "type": "string",
            "nullable": true
          },
          "countrycode": {
            "type": "string",
            "nullable": true
          },
          "url": {
            "type": "string",
            "nullable": true
          },
          "urlResolved": {
            "type": "string",
            "nullable": true
          },
          "codec": {
            "type": "string",
            "nullable": true
          },
          "tags": {
            "type": "string",
            "nullable": true
          },
          "language": {
            "type": "string",
            "nullable": true
          },
          "languagecodes": {
            "type": "string",
            "nullable": true
          },
          "geoLat": {
            "type": "number",
            "nullable": true
          },
          "geoLong": {
            "type": "number",
            "nullable": true
          },
          "votes": {
            "type": "number",
            "nullable": true
          },
          "clickcount": {
            "type": "number",
            "nullable": true
          },
          "bitrate": {
            "type": "number",
            "nullable": true
          },
          "sourceType": {
            "type": "string",
            "enum": [
              "radio_browser",
              "radio_garden",
              "both"
            ]
          },
          "catalogStatus": {
            "type": "string",
            "enum": [
              "active",
              "unverified"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "hls": {
            "type": "integer",
            "enum": [
              0,
              1
            ],
            "nullable": true
          },
          "lastcheckok": {
            "type": "integer",
            "enum": [
              0,
              1
            ],
            "nullable": true
          }
        }
      },
      "StationPage": {
        "type": "object",
        "properties": {
          "list": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Station"
            }
          },
          "page": {
            "type": "integer"
          },
          "pageSize": {
            "type": "integer"
          },
          "hasMore": {
            "type": "boolean"
          },
          "nextPage": {
            "type": "integer",
