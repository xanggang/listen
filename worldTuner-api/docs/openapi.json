              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/languages": {
      "get": {
        "operationId": "listLanguages",
        "description": "按公开电台关联数量倒序、ID 升序排列；只返回有公开电台的分类。标签 q 按字面子串匹配。",
        "parameters": [
          {
