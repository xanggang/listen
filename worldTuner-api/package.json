{
  "name": "listen-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "typegen": "wrangler types",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.runtime.json",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "build": "wrangler deploy --dry-run --outdir dist",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "check": "pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "format": "prettier --write src runtime test",
    "format:check": "prettier --check src runtime test",
    "dev:sqlite": "node --experimental-strip-types --env-file-if-exists=.env.sqlite runtime/server.ts",
    "db:export:catalog": "node --experimental-strip-types runtime/export-catalog.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "prettier": "3.9.8",
    "typescript": "5.9.3",
    "wrangler": "4.54.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.2",
    "hono": "4.13.8"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
