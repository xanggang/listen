# 从 worldTuner-api 目录运行；SQLITE_PATH 和 METRICS_SQLITE_PATH 也可以是绝对路径。
SQLITE_PATH=../worldTuner-data/v2/data/worldtuner-v2.sqlite
METRICS_SQLITE_PATH=.local/metrics.sqlite
HOST=0.0.0.0
PORT=8787
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 地图快照缓存秒数；0 禁用，数据编辑后可立即刷新。
MAP_SNAPSHOT_CACHE_TTL_SECONDS=300
