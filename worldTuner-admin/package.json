{
  "name": "worldtuner-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "format": "prettier --write src test vite.config.ts",
    "format:check": "prettier --check src test vite.config.ts"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "antd": "^6.6.6",
    "react": "19.1.4",
    "react-dom": "19.1.4"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "prettier": "3.9.8",
    "typescript": "5.9.3",
    "vite": "^7.1.3"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
